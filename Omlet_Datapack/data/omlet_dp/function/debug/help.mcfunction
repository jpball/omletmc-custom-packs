# /function omlet_dp:debug/help
# Prints every debug and admin function with what it does. Click a debug function to run it; click an admin command to
# put it in the chat box, ready to fill in its arguments. Add a line here when adding a debug or admin function
tellraw @s {"text":"Omlet Datapack debug functions (click to run):","color":"gold","bold":true}
tellraw @s [{"text":" • debug/items","color":"aqua","click_event":{"action":"run_command","command":"/function omlet_dp:debug/items"},"hover_event":{"action":"show_text","value":"Click to run"}},{"text":" - Lists every custom item. Click one to get it","color":"gray"}]
tellraw @s [{"text":" • debug/give_gun","color":"aqua","click_event":{"action":"run_command","command":"/function omlet_dp:debug/give_gun"},"hover_event":{"action":"show_text","value":"Click to run"}},{"text":" - Gives you the gun (right-click to fire)","color":"gray"}]
tellraw @s [{"text":" • debug/give_industrial_light","color":"aqua","click_event":{"action":"run_command","command":"/function omlet_dp:debug/give_industrial_light"},"hover_event":{"action":"show_text","value":"Click to run"}},{"text":" - Gives you an Industrial Light","color":"gray"}]
tellraw @s [{"text":" • debug/list_paintings","color":"aqua","click_event":{"action":"run_command","command":"/function omlet_dp:debug/list_paintings"},"hover_event":{"action":"show_text","value":"Click to run"}},{"text":" - Lists every custom painting. Click one to get it","color":"gray"}]
tellraw @s [{"text":" • debug/help","color":"aqua","click_event":{"action":"run_command","command":"/function omlet_dp:debug/help"},"hover_event":{"action":"show_text","value":"Click to run"}},{"text":" - Shows this list","color":"gray"}]

tellraw @s {"text":"Admin commands (click to fill in):","color":"gold","bold":true}
tellraw @s [{"text":" • flatworld/send","color":"yellow","click_event":{"action":"suggest_command","command":"/function omlet_dp:flatworld/send {targets:\"@s\"}"},"hover_event":{"action":"show_text","value":"Click to put in the chat box"}},{"text":" {targets} - Sends players to the flatworld, on the surface at their X/Z","color":"gray"}]
tellraw @s [{"text":" • flatworld/return","color":"yellow","click_event":{"action":"suggest_command","command":"/function omlet_dp:flatworld/return {targets:\"@s\", x:0, y:70, z:0}"},"hover_event":{"action":"show_text","value":"Click to put in the chat box"}},{"text":" {targets, x, y, z} - Sends players in the flatworld to their spawn point, or to x y z in the overworld if they don't have one","color":"gray"}]
tellraw @s [{"text":" • day_message_broadcast/set_broadcast_frequency","color":"yellow","click_event":{"action":"suggest_command","command":"/function omlet_dp:day_message_broadcast/set_broadcast_frequency {new_freq:5}"},"hover_event":{"action":"show_text","value":"Click to put in the chat box"}},{"text":" {new_freq} - Sets how many in-game days pass between day count messages","color":"gray"}]
