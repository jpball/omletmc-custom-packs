# /function omlet_dp:debug/items
# Lists every custom item. Hover over one to see it, click it to get it.
# The items match the recipe results in recipe/ (the gun has no recipe, see debug/give_gun): keep them in sync,
# and add a line here when adding a custom item
tellraw @s {"text":"Custom items (click to get one):","color":"gold","bold":true}
tellraw @s {"text":" • Gun","color":"aqua","click_event":{"action":"run_command","command":"/function omlet_dp:debug/give_gun"},"hover_event":{"action":"show_item","id":"minecraft:carrot_on_a_stick","components":{"minecraft:item_name":"Gun","minecraft:item_model":"omlet_rp:block_17","minecraft:custom_data":{"omlet_gun":true}}}}
tellraw @s {"text":" • Industrial Light","color":"aqua","click_event":{"action":"run_command","command":"/loot give @s loot omlet_dp:industrial_light"},"hover_event":{"action":"show_item","id":"minecraft:item_frame","components":{"minecraft:item_name":"Industrial Light","minecraft:item_model":"omlet_rp:industrial_light"}}}
tellraw @s {"text":" • Player Saddle","color":"aqua","click_event":{"action":"run_command","command":"/give @s minecraft:leather_chestplate[minecraft:item_name='Player Saddle',minecraft:item_model='omlet_rp:player_saddle',minecraft:custom_data={player_saddle:true}]"},"hover_event":{"action":"show_item","id":"minecraft:leather_chestplate","components":{"minecraft:item_name":"Player Saddle","minecraft:item_model":"omlet_rp:player_saddle","minecraft:custom_data":{"player_saddle":true}}}}
tellraw @s [{"text":" • Torch Arrow","color":"aqua","click_event":{"action":"run_command","command":"/give @s minecraft:arrow[minecraft:item_name='Torch Arrow',minecraft:item_model='omlet_rp:torch_arrow',minecraft:custom_data={torch_arrow:true}] 16"},"hover_event":{"action":"show_item","id":"minecraft:arrow","components":{"minecraft:item_name":"Torch Arrow","minecraft:item_model":"omlet_rp:torch_arrow","minecraft:custom_data":{"torch_arrow":true}}}},{"text":" x16","color":"gray"}]
tellraw @s {"text":" • National Anthem of USSR (music disc)","color":"aqua","click_event":{"action":"run_command","command":"/give @s minecraft:music_disc_pigstep[minecraft:jukebox_playable='omlet_dp:ussr_anthem',minecraft:item_name='National Anthem of USSR']"},"hover_event":{"action":"show_item","id":"minecraft:music_disc_pigstep","components":{"minecraft:jukebox_playable":"omlet_dp:ussr_anthem","minecraft:item_name":"National Anthem of USSR"}}}
tellraw @s {"text":" • Vine Boom Goat Horn","color":"aqua","click_event":{"action":"run_command","command":"/give @s minecraft:goat_horn[minecraft:instrument='omlet_dp:vboomhorn']"},"hover_event":{"action":"show_item","id":"minecraft:goat_horn","components":{"minecraft:instrument":"omlet_dp:vboomhorn"}}}
tellraw @s [{"text":" • Paintings...","color":"aqua","click_event":{"action":"run_command","command":"/function omlet_dp:paintings/list"},"hover_event":{"action":"show_text","value":"Click to list the custom paintings"}},{"text":" - opens the painting list","color":"gray"}]
